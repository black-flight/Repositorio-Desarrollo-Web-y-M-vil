# NO introducir claves reales aquí. Generar .env con: python backend/scripts/init_local_env.py
VAULT_DEV_ROOT_TOKEN_ID=GENERAR_LOCAL
VAULT_TOKEN=GENERAR_LOCAL
INTERNAL_GATEWAY_SECRET=GENERAR_LOCAL
AUTH_INTROSPECTION_SECRET=GENERAR_LOCAL
GRAPHQL_GATEWAY_SECRET=GENERAR_LOCAL
PAYMENTS_TO_ORDERS_SECRET=GENERAR_LOCAL
PAYMENT_TEST_SECRET=GENERAR_LOCAL
PAYMENT_TEST_MODE=1
AUTH_PASSWORD_ANA=GENERAR_LOCAL
AUTH_PASSWORD_PEDRO=GENERAR_LOCAL
AUTH_PASSWORD_ERNESTO=GENERAR_LOCAL
AUTH_PASSWORD_COCINA=GENERAR_LOCAL
# POSICIÓN 100 % SINTÉTICA para probar el cálculo de radio; reemplazar por punto real verificado.
DELIVERY_STORE_LAT=-33.510000
DELIVERY_STORE_LON=-70.750000
DELIVERY_RADIUS_KM=3
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
FRONTEND_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:8080,http://127.0.0.1:8080
# Correo por API REST HTTP; vacío = MongoDB DEMO (NO envía correo externo)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@tokyonoodles.test
EMAIL_DEMO_MODE=1
EMAIL_ALLOW_HTTP_LOCAL=0
# Activar 1 para ventas reales con verificación HTTP completada; 0 solo demostración académica.
EMAIL_REQUIRE_VERIFIED=0
